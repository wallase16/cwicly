{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cwicly/map",
    "title": "Map (Leaflet)",
    "category": "cwicly",
    "description": "Embed an interactive Leaflet map.",
    "keywords": [
        "map",
        "leaflet",
        "address",
        "cwicly"
    ],
    "textdomain": "cwicly",
    "attributes": {
        "uniqueID": { "type": "string" },
        "classID": { "type": "string" },
        "latitude": { "type": "number", "default": 48.8566 },
        "longitude": { "type": "number", "default": 2.3522 },
        "zoom": { "type": "number", "default": 13 },
        "markerTitle": { "type": "string", "default": "" },
        "markerContent": { "type": "string", "default": "" },
        "minHeight": { "type": "string", "default": "400px" },
        "tileLayer": { "type": "string", "default": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png" },
        "attribution": { "type": "string", "default": "&copy; OpenStreetMap contributors" },
        "linkWrapperActive": { "type": "boolean", "default": false },
        "isStyling": { "type": "boolean", "default": true },
        "customCSS": { "type": "string", "default": "" }
    },
    "supports": {
        "anchor": true,
        "html": false
    },
    "editorScript": "file:./index.js",
    "style": "cwicly-map-style"
}
